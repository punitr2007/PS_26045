# =====================================================================
# Frontend Environment Variables
# =====================================================================

# Backend Base URL
# Leave empty in local development to use the Vite dev server proxy (/api/* -> localhost:8001).
# In production (e.g. Vercel / Netlify / Cloudflare), set this to your deployed backend URL:
# VITE_BACKEND_URL=https://api.ip-shakti.gov.in
# or
# VITE_BACKEND_URL=https://your-backend.onrender.com
VITE_BACKEND_URL=
